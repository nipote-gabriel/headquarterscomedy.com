{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/about", "destination": "/#about", "permanent": true },
    { "source": "/about.html", "destination": "/#about", "permanent": true },
    { "source": "/live-shows", "destination": "/#tickets", "permanent": true },
    { "source": "/live-shows.html", "destination": "/#tickets", "permanent": true },
    { "source": "/brands", "destination": "/#book", "permanent": true },
    { "source": "/brands.html", "destination": "/#book", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
